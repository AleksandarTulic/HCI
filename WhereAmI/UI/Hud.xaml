<UserControl x:Class="WhereAmI.UI.Hud"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
  <Grid Margin="32,26">
    <!-- Top-left: lives as little lanterns, then coins and score. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
      <Border Style="{StaticResource Pill}">
        <StackPanel x:Name="Lanterns" Orientation="Horizontal" />
      </Border>

      <!-- Eggs ready to throw; the next one fills in while it recharges. -->
      <Border Style="{StaticResource Pill}" ToolTip="Eggs (X or J to throw)">
        <StackPanel x:Name="EggIcons" Orientation="Horizontal" />
      </Border>

      <Border Style="{StaticResource Pill}">
        <StackPanel Orientation="Horizontal">
          <Image x:Name="CoinIcon" Width="26" Height="26" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><ScaleTransform x:Name="CoinBump" /></Image.RenderTransform>
          </Image>
          <TextBlock x:Name="CoinsText" Style="{StaticResource NumberText}" FontSize="26" Foreground="{StaticResource AmberSoftBrush}" />
          <TextBlock x:Name="CoinsTotal" Style="{StaticResource NumberText}" FontSize="18" Foreground="{StaticResource TextDimBrush}"
                     VerticalAlignment="Bottom" Margin="4,0,0,3" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Pill}">
        <TextBlock x:Name="ScoreText" Style="{StaticResource NumberText}" FontSize="26" RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform><ScaleTransform x:Name="ScoreBump" /></TextBlock.RenderTransform>
        </TextBlock>
      </Border>
    </StackPanel>

    <!-- Top-right: the clock. Turns red and pulses when time is short. -->
    <Border x:Name="ClockPill" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="ClockPulse" /></Border.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <Path x:Name="ClockIcon" Width="22" Height="22" Margin="0,0,10,0" Stretch="Uniform" StrokeThickness="2.2"
              Stroke="{StaticResource TextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 12,2 A 10,10 0 1 1 11.99,2 Z M 12,6 L 12,12 L 16,14" VerticalAlignment="Center" />
        <TextBlock x:Name="TimeText" Style="{StaticResource NumberText}" FontSize="26" />
      </StackPanel>
    </Border>

    <!-- Contextual hint near the bottom, shown while the player is in a hint area. -->
    <Border x:Name="HintPill" Style="{StaticResource Pill}" Margin="0" Padding="26,12"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0" Background="#D9141920">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="10" Height="10" Fill="{StaticResource AmberBrush}" Effect="{StaticResource AmberGlow}"
                 VerticalAlignment="Center" Margin="0,0,14,0" />
        <TextBlock x:Name="HintText" Style="{StaticResource BodyText}" FontSize="22" />
      </StackPanel>
    </Border>

    <!-- Short messages in the middle: level name at the start, "Music off", and so on. -->
    <StackPanel x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0" Opacity="0">
      <TextBlock x:Name="ToastSmall" Style="{StaticResource LabelText}" HorizontalAlignment="Center" FontSize="18" />
      <TextBlock x:Name="ToastBig" Style="{StaticResource HeadingText}" FontSize="58" HorizontalAlignment="Center">
        <TextBlock.Effect>
          <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="16" Opacity="0.8" />
        </TextBlock.Effect>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
