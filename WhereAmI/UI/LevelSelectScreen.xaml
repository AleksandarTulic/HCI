<ui:Screen x:Class="WhereAmI.UI.LevelSelectScreen"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:WhereAmI.UI">
  <ui:Screen.Resources>
    <!-- A level on the trail: a lantern-like orb with the level number. -->
    <Style x:Key="TrailNode" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="96" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="Grow" />
              </Grid.RenderTransform>
              <Ellipse x:Name="Halo" Width="150" Height="150" Margin="-27" Opacity="0.35">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#99FFB547" Offset="0" />
                    <GradientStop Color="#00FFB547" Offset="1" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Ellipse x:Name="Orb" Fill="#E6141920" Stroke="{StaticResource AmberBrush}" StrokeThickness="3" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="done">
                <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource TealBrush}" />
              </Trigger>
              <Trigger Property="Tag" Value="locked">
                <Setter TargetName="Orb" Property="Stroke" Value="{StaticResource LineBrush}" />
                <Setter TargetName="Halo" Property="Opacity" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="1" />
                <Setter TargetName="Orb" Property="Effect" Value="{StaticResource AmberGlow}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:Screen.Resources>

  <Grid>
    <Rectangle Fill="#E00E1116" />

    <StackPanel Margin="140,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
      <TextBlock Text="Choose your path" Style="{StaticResource HeadingText}" />
      <TextBlock Text="Every lantern you light opens the way further into the fog." Style="{StaticResource SubheadingText}" Margin="2,6,0,0" />
    </StackPanel>

    <!-- The trail and its lanterns are placed in code so they fit any window width. -->
    <Canvas x:Name="Trail" Margin="0,220,0,320" />

    <!-- Details for the focused level. -->
    <Border Style="{StaticResource Card}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,110" MinWidth="760" Padding="40,26">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="DetailNumber" Style="{StaticResource LabelText}" Text="LEVEL 1" />
          <TextBlock x:Name="DetailName" Style="{StaticResource HeadingText}" FontSize="40" Text="Foggy Meadow" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:StarRow x:Name="DetailStars" StarSize="26" />
            <TextBlock x:Name="DetailStats" Style="{StaticResource BodyText}" Foreground="{StaticResource TextDimBrush}"
                       Margin="22,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Play"
                VerticalAlignment="Center" Margin="40,0,0,0" Click="Play_Click" />
      </Grid>
    </Border>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="140,0,0,48">
      <Border Style="{StaticResource Keycap}"><TextBlock Text="← →" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="choose" Style="{StaticResource HintText}" Margin="2,0,24,0" VerticalAlignment="Center" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="play" Style="{StaticResource HintText}" Margin="2,0,24,0" VerticalAlignment="Center" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="back" Style="{StaticResource HintText}" Margin="2,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</ui:Screen>
