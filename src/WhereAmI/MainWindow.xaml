<Window x:Class="WhereAmI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:WhereAmI.Rendering"
        Title="Where Am I?"
        Width="1280" Height="800"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="White">

  <Window.Resources>
    <Style x:Key="HudText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Foreground" Value="#D32F2F" />
      <Setter Property="Margin" Value="0,0,48,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <rendering:GameSurface x:Name="Surface" />

    <!-- HUD: drawn on top of the world and never moves with the camera. -->
    <StackPanel x:Name="HudPanel" Orientation="Horizontal" Margin="32,24,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top">
      <Image x:Name="SoundIcon" Width="40" Height="40" Margin="0,0,24,0" Cursor="Hand"
             ToolTip="Music on/off (M)" MouseLeftButtonUp="SoundIcon_Click" />
      <TextBlock x:Name="TimeText" Style="{StaticResource HudText}" />
      <TextBlock x:Name="LivesText" Style="{StaticResource HudText}" />
      <TextBlock x:Name="PointsText" Style="{StaticResource HudText}" />
      <TextBlock x:Name="LevelText" Style="{StaticResource HudText}" Foreground="#555555" />
    </StackPanel>

    <!-- Game over / victory message. Replaced by proper screens in the UI redesign phase. -->
    <Border x:Name="MessagePanel" Visibility="Collapsed"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#E6FFFFFF" BorderBrush="#222222" BorderThickness="2"
            CornerRadius="8" Padding="40,28">
      <StackPanel>
        <TextBlock x:Name="MessageTitle" FontFamily="Segoe UI" FontSize="40" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="MessageBody" FontFamily="Segoe UI" FontSize="20" Margin="0,16,0,0"
                   TextAlignment="Center" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
