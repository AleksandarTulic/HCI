<ui:Screen x:Class="WhereAmI.UI.OptionsScreen"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:WhereAmI.UI">
  <ui:Screen.Resources>
    <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="SettingRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,30" />
    </Style>
  </ui:Screen.Resources>

  <Grid>
    <Rectangle Fill="#C70E1116" />

    <Border Style="{StaticResource Card}" Width="1120" Height="660" Padding="0"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tabs -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="28,40">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Options" Style="{StaticResource HeadingText}" FontSize="44" Margin="18,0,0,30" />
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Content="Back" Tag="back"
                    HorizontalAlignment="Left" Margin="12,0,0,0" Click="Back_Click" />
            <StackPanel x:Name="Tabs" KeyboardNavigation.DirectionalNavigation="Cycle">
              <RadioButton x:Name="SoundTab" Style="{StaticResource SideTab}" Content="Sound" GroupName="tabs" IsChecked="True" Checked="Tab_Checked" />
              <RadioButton Style="{StaticResource SideTab}" Content="Display" GroupName="tabs" Checked="Tab_Checked" />
              <RadioButton Style="{StaticResource SideTab}" Content="Gameplay" GroupName="tabs" Checked="Tab_Checked" />
              <RadioButton Style="{StaticResource SideTab}" Content="Controls" GroupName="tabs" Checked="Tab_Checked" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="56,48,56,40">
          <!-- Sound -->
          <StackPanel x:Name="SoundPage">
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Music" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="The quiet tune that follows you through the fog." Style="{StaticResource LabelText}" Margin="0,2,0,8" />
                <Slider x:Name="MusicSlider" Style="{StaticResource GlowSlider}" ValueChanged="Music_Changed" />
              </StackPanel>
              <TextBlock x:Name="MusicValue" Grid.Column="1" Style="{StaticResource NumberText}" FontSize="24"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Sound effects" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Coins, jumps, menus. You will hear a sample as you change it." Style="{StaticResource LabelText}" Margin="0,2,0,8" />
                <Slider x:Name="EffectsSlider" Style="{StaticResource GlowSlider}" ValueChanged="Effects_Changed" />
              </StackPanel>
              <TextBlock x:Name="EffectsValue" Grid.Column="1" Style="{StaticResource NumberText}" FontSize="24"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </Grid>
          </StackPanel>

          <!-- Display -->
          <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Fullscreen" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Fill the whole screen. F11 or Alt+Enter also switch it." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
              </StackPanel>
              <CheckBox x:Name="FullscreenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center" Checked="Fullscreen_Click" Unchecked="Fullscreen_Click" />
            </Grid>
            <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap">
              The game adapts to any resolution: the whole height of a level always fits the screen,
              and wider screens simply see more of the world.
            </TextBlock>
          </StackPanel>

          <!-- Gameplay -->
          <StackPanel x:Name="GameplayPage" Visibility="Collapsed">
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Screen shake" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Shake the view when you stomp an enemy or lose a life." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
              </StackPanel>
              <CheckBox x:Name="ShakeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center" Checked="Shake_Click" Unchecked="Shake_Click" />
            </Grid>
          </StackPanel>

          <!-- Controls -->
          <StackPanel x:Name="ControlsPage" Visibility="Collapsed">
            <ItemsControl x:Name="ControlsList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="260" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Action}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource Keycap}">
                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" FontSize="16" HorizontalAlignment="Center" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</ui:Screen>
