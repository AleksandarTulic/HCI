<ui:Screen x:Class="WhereAmI.UI.IntroScreen"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:WhereAmI.UI"
           Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
           MouseLeftButtonUp="OnClick">
  <Grid>
    <Rectangle Fill="#EB0E1116" />

    <TextBlock x:Name="Line" Style="{StaticResource HeadingText}" FontSize="52" FontStyle="Italic"
               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100"
               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />

    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56">
      <Border Style="{StaticResource Keycap}"><TextBlock Text="Space" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="continue" Style="{StaticResource HintText}" Margin="2,0,24,0" VerticalAlignment="Center" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="skip" Style="{StaticResource HintText}" Margin="2,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</ui:Screen>
