<ui:Screen x:Class="WhereAmI.UI.MainMenuScreen"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:WhereAmI.UI">
  <Grid>
    <!-- Fog: dark on the left where the menu is, thinning out to the right so the level shows through. -->
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#F50E1116" Offset="0" />
          <GradientStop Color="#D90E1116" Offset="0.38" />
          <GradientStop Color="#730E1116" Offset="0.75" />
          <GradientStop Color="#4D0E1116" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- The hero stands in a pool of lantern light on the right. -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,120">
      <Ellipse Width="520" Height="520">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#66FFB547" Offset="0" />
            <GradientStop Color="#1FFFB547" Offset="0.45" />
            <GradientStop Color="#00FFB547" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Image x:Name="Hero" Width="230" Height="210" Stretch="Uniform" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <Ellipse Width="200" Height="22" VerticalAlignment="Bottom" Margin="0,0,0,130" Fill="#40000000" />
    </Grid>

    <StackPanel VerticalAlignment="Center" Margin="140,0,0,40">
      <TextBlock Text="Where Am I?" Style="{StaticResource LogoText}" Margin="-6,0,0,-18" />
      <TextBlock Text="A small light in a very big fog." Style="{StaticResource SubheadingText}" Margin="4,0,0,0" />

      <StackPanel x:Name="Menu" Margin="-30,56,0,0" KeyboardNavigation.DirectionalNavigation="Cycle">
        <Button x:Name="PlayButton" Style="{StaticResource MenuItemButton}" Content="Play" Click="Play_Click" />
        <Button Style="{StaticResource MenuItemButton}" Content="Levels" Click="Levels_Click" />
        <Button Style="{StaticResource MenuItemButton}" Content="Options" Click="Options_Click" />
        <Button Style="{StaticResource MenuItemButton}" Content="Quit" Click="Quit_Click" Tag="back" />
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="140,0,0,48">
      <Border Style="{StaticResource Keycap}"><TextBlock Text="↑ ↓" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="choose" Style="{StaticResource HintText}" Margin="2,0,24,0" VerticalAlignment="Center" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="select" Style="{StaticResource HintText}" Margin="2,0,24,0" VerticalAlignment="Center" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="F11" Style="{StaticResource HintText}" /></Border>
      <TextBlock Text="fullscreen" Style="{StaticResource HintText}" Margin="2,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</ui:Screen>
